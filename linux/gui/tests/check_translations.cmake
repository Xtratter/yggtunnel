# Fails when a source string has no Russian translation, or the .ts is out of date with the sources.
# Usage: cmake -DLUPDATE=… -DSRC=<gui dir> -DWORK=<scratch dir> -P check_translations.cmake
file(MAKE_DIRECTORY ${WORK})
file(COPY_FILE ${SRC}/translations/yggtunnel_ru.ts ${WORK}/check.ts ONLY_IF_DIFFERENT)
execute_process(COMMAND ${LUPDATE} ${SRC}/qml ${SRC}/src -no-obsolete -source-language en -target-language ru -ts ${WORK}/check.ts
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "lupdate failed: ${err}")
endif()
file(READ ${WORK}/check.ts ts)
# CMake regexes have no lazy matching: split on the closing tag instead (no source string contains ";")
string(REPLACE ";" "\\;" ts "${ts}")
string(REPLACE "</message>" "</message>;" parts "${ts}")
set(messages "")
foreach(part IN LISTS parts)
    if(part MATCHES "<message>")
        list(APPEND messages "${part}")
    endif()
endforeach()
set(missing "")
foreach(m IN LISTS messages)
    if(m MATCHES "type=\"unfinished\"" OR m MATCHES "<translation></translation>")
        string(REGEX MATCH "<source>([^<]*)</source>" _ "${m}")
        list(APPEND missing "${CMAKE_MATCH_1}")
    endif()
endforeach()
if(missing)
    string(REPLACE ";" "\n  " list "${missing}")
    message(FATAL_ERROR "Strings without a Russian translation:\n  ${list}\n(update translations/yggtunnel_ru.ts)")
endif()
list(LENGTH messages n)
if(n LESS 30)
    message(FATAL_ERROR "only ${n} messages found; the check itself is broken")
endif()
message(STATUS "all ${n} strings are translated")
